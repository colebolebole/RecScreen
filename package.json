{
  "name": "velocity-studio",
  "version": "1.4.1",
  "description": "Velocity Studio - an OBS-style screen recorder and streamer",
  "main": "main.js",
  "desktopName": "velocity-studio.desktop",
  "author": "Cole",
  "license": "MIT",
  "homepage": "https://github.com/colebolebole/velocity-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/colebolebole/velocity-studio.git"
  },
  "private": true,
  "scripts": {
    "ffmpeg": "node scripts/fetch-ffmpeg.js",
    "start": "electron .",
    "selftest": "electron . --selftest",
    "icon": "node scripts/make-ico.js",
    "dist": "electron-builder --win nsis --publish never",
    "dist:linux": "bash scripts/build-linux.sh"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.velocitystudio.app",
    "productName": "Velocity Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "taskbar.js",
      "ffmpeg-builds.js",
      "ffmpeg-setup.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman",
        "tar.gz"
      ],
      "icon": "src/icon.png",
      "category": "AudioVideo",
      "executableName": "velocity-studio",
      "syncDesktopName": true,
      "synopsis": "OBS-style screen recorder and live streamer",
      "maintainer": "Cole <colebolebole@users.noreply.github.com>"
    },
    "appImage": {
      "artifactName": "velocity-studio-${version}.AppImage"
    },
    "deb": {
      "recommends": [
        "ffmpeg"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": false,
      "include": "build/installer.nsh"
    }
  }
}
